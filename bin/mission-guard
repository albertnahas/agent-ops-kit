#!/usr/bin/env python3
"""Model-free guard for the protected parts of a charter: the text inside its mission markers,
an HTML comment line `mission` to open a block and `/mission` to close it.

mission-guard bless <file>...  record each charter's marked blocks as they are on its repo's default branch (you, at a terminal)
mission-guard check            alert when a recorded charter's blocks changed on the default branch since its bless
mission-guard pr               run in a PR checkout: exit 1 if it changes mission blocks or a protected path, 2 if it can't tell
mission-guard orders           run in an Orders PR checkout: exit 1 unless it only appends one dated Changes line to docs/orders/ files
mission-guard author <n>       exit 1 unless PR n's author can push to this repo, 2 if it can't tell: run it before anything reads the PR

State lives in $AGENT_OPS_DIR/missions.json (default ~/.agent-ops). Push your own edit, then bless it.
The heartbeat runs check. The loop that grades PRs runs pr on each head (it needs no state, so a copy of
this file in the product repo works in the cloud; run the default branch's copy, never the PR's) and
grades any non-zero exit X, whatever the model thinks. Bless asks you to retype the file names at a
terminal, so a loop can't bless its own edit by accident; an agent that can drive a pseudo-terminal still can."""
import datetime as dt, difflib, json, os, re, subprocess, sys
from pathlib import Path

OPS = Path(os.environ.get("AGENT_OPS_DIR", Path.home() / ".agent-ops"))
STORE = OPS / "missions.json"
OPEN = "<!-- mission -->"
MARKER = re.compile(r"^[ \t]*(<!-- /?mission -->)[ \t]*$", re.M)
ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}


def blocks(text):
    """The marked blocks, or an error string when the markers don't pair up."""
    out, start = [], None
    for m in MARKER.finditer(text):
        if (m.group(1) == OPEN) == (start is not None):
            return f"unpaired {m.group(1)} at line {text.count(chr(10), 0, m.start()) + 1}"
        if m.group(1) == OPEN:
            start = m.end()
        else:
            out.append(text[start:m.start()].strip())
            start = None
    return "unclosed mission block" if start is not None else out


def git(repo, *args):
    try:
        return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, env=ENV, timeout=60)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out")


def default_branch(repo):
    """(origin's default branch, None) after a fetch, or (None, why not)."""
    if git(repo, "fetch", "-q", "origin").returncode:
        return None, "fetch failed"
    branch = re.search(r"ref: refs/heads/(\S+)\s+HEAD", git(repo, "ls-remote", "--symref", "origin", "HEAD").stdout)
    return (branch.group(1), None) if branch else (None, "can't read origin's default branch")


def default_text(repo, rel):
    """(text of the file on origin's default branch, None) or (None, why not)."""
    branch, why = default_branch(repo)
    if why:
        return None, why
    shown = git(repo, "show", f"origin/{branch}:{rel}")
    return (shown.stdout, None) if shown.returncode == 0 else (None, f"missing on origin/{branch}")


def load():
    try:
        return json.loads(STORE.read_text()) if STORE.exists() else {}
    except json.JSONDecodeError as e:
        sys.exit(f"{STORE} is not valid JSON ({e}). Fix it or bless your charters again.")


def diff(old, new):
    lines = [l for l in list(difflib.unified_diff(old.splitlines(), new.splitlines(), lineterm="", n=0))[2:] if l[:1] in "+-"]
    return "\n".join("    " + l for l in lines[:8])


def bless(files):
    store, found = load(), {}
    for f in files:
        p = Path(f).expanduser().resolve()
        top = git(str(p.parent), "rev-parse", "--show-toplevel").stdout.strip() if p.is_file() else ""
        if not top:
            return f"{f}: not a file in a git repo"
        rel = str(p.relative_to(Path(top).resolve()))
        local = blocks(p.read_text())
        if isinstance(local, str) or not local:
            return f"{f}: {local or 'no mission blocks'}"
        remote, why = default_text(top, rel)
        if why:
            return f"{f}: {why}"
        if blocks(remote) != local:
            return f"{f}: its mission blocks differ from origin's default branch. Push first, then bless."
        found[str(p)] = {"repo": top, "rel": rel, "blocks": local, "blessed": dt.date.today().isoformat()}
    if not sys.stdin.isatty():
        return "bless needs you at a terminal: run it yourself, never from a loop."
    want = " ".join(Path(p).name for p in found)
    if input(f"Bless the mission blocks of {want}? Retype the file name(s) to confirm: ").strip() != want:
        return "Not blessed: the names didn't match."
    store.update(found)
    OPS.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(store, indent=2) + "\n")
    print("\n".join(f"blessed {p}" for p in found))


def check():
    """Prints `drift: <path>` (with the diff) or `unreadable: <path>: <why>` per charter.
    Exits 1 on any drift, else 2 if any charter couldn't be read or none is recorded, else 0."""
    store, drift, unread = load(), 0, 0
    if not store:
        print(f"no charters recorded in {STORE}, so nothing is guarded. Bless each charter.")
        return 2
    for path, e in store.items():
        text, why = default_text(e["repo"], e["rel"])
        now = why or blocks(text)
        if now == e["blocks"]:
            continue
        if why and why.startswith("missing on"):
            drift += 1
            print(f"drift: {path}: {why}, deleted since the bless on {e['blessed']}")
        elif why:
            unread += 1
            print(f"unreadable: {path}: {why}")
        elif isinstance(now, str):
            drift += 1
            print(f"drift: {path}: {now} since the bless on {e['blessed']}")
        else:
            drift += 1
            print(f"drift: {path}: changed since the bless on {e['blessed']}\n{diff(chr(10).join(e['blocks']), chr(10).join(now))}")
    print(f"{len(store) - drift - unread} of {len(store)} charters clean")
    return 1 if drift else 2 if unread else 0


PROTECTED = (".mcp.json", ".husky/", ".github/workflows/", ".github/actions/", "scripts/mission-guard",
             "bin/mission-guard", ".mission-guard", "scripts/run.sh", "bin/claude-run", "bin/ops-check", "checks/")
AGENT_FILES = ("claude.md", "claude.local.md", "agents.md")
ORDERS = re.compile(r"docs/orders/[^/]+\.md")
DATED = re.compile(r"\n?\d{4}-\d{2}-\d{2} \|[^|\n]*\w[^|\n]*\|[^|\n]*\w[^|\n]*\|?\n?")
names = lambda out: [f for f in out.split("\0") if f]


def checkout():
    """(repo top, default branch, its merge-base with HEAD, tracked files this checkout changes since that base),
    or exit 2: can't tell is X."""
    top = git(".", "rev-parse", "--show-toplevel").stdout.strip()
    branch, why = default_branch(top) if top else (None, "not inside a git checkout")
    base = git(top, "merge-base", f"origin/{branch}", "HEAD").stdout.strip() if not why else ""
    if not base:
        print(f"{why or 'no merge-base with the default branch'}: can't tell, treat the PR as X")
        sys.exit(2)
    return top, branch, base, sorted(names(git(top, "diff", "-z", "--name-only", "--no-renames", base).stdout))


def appended(old, new):
    """True when new is old plus one dated `date | why | by` line at its end: the only Orders change that isn't X."""
    return old is not None and new is not None and new.startswith(old) and \
        (old.endswith("\n") or new[len(old):].startswith("\n")) and DATED.fullmatch(new[len(old):]) is not None


def imports(top, ref):
    """Repo paths that an agent file (CLAUDE.md, CLAUDE.local.md, AGENTS.md) on ref pulls in through `@path`, followed
    as Claude Code does: relative to the importing file, outside code, four hops deep."""
    show = lambda rel: git(top, "show", f"{ref}:{rel}").stdout
    todo = [f for f in names(git(top, "ls-tree", "-rz", "--name-only", ref).stdout) if Path(f).name.lower() in AGENT_FILES]
    seen = set()
    for _ in range(5):
        found = set()
        for f in todo:
            text = re.sub(r"`[^`]*`", "", re.sub(r"(?ms)^```.*?^```", "", show(f)))
            for m in re.findall(r"(?<![\w`])@([^\s`]+)", text):
                m = m.rstrip(".,;:)")
                path = os.path.normpath(m if m.startswith("/") else os.path.join(top, os.path.dirname(f), m))
                if not m.startswith("~") and path.startswith(top + os.sep):
                    found.add(os.path.relpath(path, top))
        todo = sorted(found - seen)
        seen |= found
    return seen


def pr():
    """Store-free, so it works wherever the PR is checked out, a CI job included. Flags a change since the
    merge-base to any file's mission blocks, and any change to a protected path: agent config (.claude/ at
    any depth, CLAUDE.md, CLAUDE.local.md, AGENTS.md, .mcp.json), git hooks, CI workflows and actions, the runner and its checks, the guard itself, and the
    paths listed in `.mission-guard` on the default branch, and files an agent file there imports with `@`. An Orders
    file may only gain one dated Changes line at its end; a new or rewritten one is X. Exits 1 on a hit (grade X), 2 if it can't
    tell, an unpaired marker included (treat as X), 0 if none."""
    top, branch, base, changed = checkout()
    show = lambda ref, rel: git(top, "show", f"{ref}:{rel}")
    extra = show(f"origin/{branch}", ".mission-guard")
    protected = tuple(p.lower() for p in PROTECTED + tuple(extra.stdout.split() if extra.returncode == 0 else ()))
    imported = {p.lower() for p in imports(top, f"origin/{branch}")}
    grep = lambda *ref: names(git(top, "grep", "-lzE", r"^[[:space:]]*<!-- /?mission -->[[:space:]]*$", *ref).stdout)
    charters = set(grep()) | {f.split(":", 1)[1] for f in grep(base)}
    hits = [f"{rel}: a protected path. Grade X." for rel in changed
            if rel.lower().startswith(protected) or ".claude" in Path(rel.lower()).parts[:-1]
            or Path(rel).name.lower() in AGENT_FILES or rel.lower() in imported]
    read = lambda rel: (Path(top) / rel).read_text() if (Path(top) / rel).is_file() else None
    hits += [f"{rel}: changes an Orders file beyond one appended dated Changes line. Grade X." for rel in changed
             if ORDERS.fullmatch(rel) and not appended(show(base, rel).stdout if show(base, rel).returncode == 0 else None, read(rel))]
    unsure = []
    for rel in sorted(charters & set(changed)):
        f, b = Path(top) / rel, show(base, rel)
        now, then = blocks(f.read_text()) if f.is_file() else None, blocks(b.stdout) if b.returncode == 0 else None
        if isinstance(now, str) or isinstance(then, str):
            unsure.append(f"{rel}: {now if isinstance(now, str) else then}, so its blocks can't be compared. Treat as X.")
        elif now != then:
            hits.append(f"{rel}: this checkout changes its mission blocks. Grade X.")
    print("\n".join(hits + unsure + [f"{len(hits)} hit(s) across {len(charters)} charter(s) and {len(changed)} changed file(s)"]))
    return 1 if hits else 2 if unsure else 0


def orders():
    """For a PR that changes Orders: it may change only files under docs/orders/, and each one only gains one
    dated `date | why | by` line at its end. Exits 1 if not, 2 if it can't tell."""
    top, branch, base, changed = checkout()
    bad = []
    for rel in changed:
        b, f = git(top, "show", f"{base}:{rel}"), Path(top) / rel
        if not ORDERS.fullmatch(rel):
            bad.append(f"{rel}: not an Orders file")
        elif not appended(b.stdout if b.returncode == 0 else None, f.read_text() if f.is_file() else None):
            bad.append(f"{rel}: needs exactly one dated `date | why | by` line appended to Changes, and no other change")
    print("\n".join(bad + [f"{len(changed)} file(s) checked, {len(bad)} problem(s)"]))
    return 1 if bad or not changed else 0


def author(n):
    """Model-free gate run before any grading: PR n's author must have write, maintain or admin access to this
    repo. A stranger's PR, a bot's included, is X before a model reads it or its code runs."""
    gh = lambda *a: subprocess.run(["gh", *a], capture_output=True, text=True, env=ENV, timeout=60)
    login = gh("pr", "view", n, "--json", "author", "-q", ".author.login").stdout.strip()
    perm = gh("api", f"repos/{{owner}}/{{repo}}/collaborators/{login}/permission", "-q", ".permission").stdout.strip() if login else ""
    if not perm:
        print(f"#{n}: can't read its author's access, treat the PR as X")
        return 2
    ok = perm in ("admin", "maintain", "write")
    print(f"#{n} by {login}: {perm} access. " + ("Grade it." if ok else "Not a collaborator who can push. Grade X."))
    return 0 if ok else 1


cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
if cmd == "bless" and args:
    sys.exit(bless(args))
if cmd == "author" and len(args) == 1 and args[0].isdigit():
    sys.exit(author(args[0]))
if cmd in ("check", "pr", "orders") and not args:
    sys.exit({"check": check, "pr": pr, "orders": orders}[cmd]())
sys.exit("usage: mission-guard bless <file>... | mission-guard check | mission-guard pr | mission-guard orders | mission-guard author <n>")
