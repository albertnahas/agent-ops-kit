#!/usr/bin/env python3
"""Model-free guard for the protected parts of a charter.

mission-guard bless <file>...  store the text between <!-- mission --> and <!-- /mission --> markers
mission-guard check            compare each stored charter, as it is on its repo's origin default branch,
                               with what was blessed. Prints each drift, exits 1 if any.

State lives in $AGENT_OPS_DIR/missions.json (default ~/.agent-ops). Bless after your own edit; the
heartbeat runs check, so a charter whose marked blocks changed without you raises an alert."""
import datetime as dt, hashlib, json, os, re, subprocess, sys
from pathlib import Path

OPS = Path(os.environ.get("AGENT_OPS_DIR", Path.home() / ".agent-ops"))
STORE = OPS / "missions.json"
BLOCKS = re.compile(r"<!-- mission -->(.*?)<!-- /mission -->", re.S)


def digest(text):
    blocks = BLOCKS.findall(text)
    return hashlib.sha256("\0".join(b.strip() for b in blocks).encode()).hexdigest() if blocks else None


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def load():
    return json.loads(STORE.read_text()) if STORE.exists() else {}


def bless(files):
    store, bad = load(), 0
    for f in files:
        p = Path(f).expanduser().resolve()
        h = digest(p.read_text()) if p.is_file() else None
        top = git(str(p.parent), "rev-parse", "--show-toplevel").stdout.strip() if p.is_file() else ""
        if not h or not top:
            print(f"{f}: no mission blocks or not in a git repo", file=sys.stderr)
            bad += 1
            continue
        store[str(p)] = {"repo": top, "rel": str(p.relative_to(Path(top).resolve())), "sha256": h,
                         "blessed": dt.date.today().isoformat()}
        print(f"blessed {p}")
    if bad:
        return 1
    OPS.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(store, indent=2) + "\n")
    return 0


def check():
    drift, store = 0, load()
    for path, e in store.items():
        git(e["repo"], "fetch", "-q")
        ref = next((r for r in ("origin/HEAD", "origin/main") if git(e["repo"], "rev-parse", "-q", "--verify", r).returncode == 0), None)
        shown = git(e["repo"], "show", f"{ref}:{e['rel']}") if ref else None
        if not shown or shown.returncode != 0:
            print(f"{path}: missing on origin")
        elif digest(shown.stdout) != e["sha256"]:
            print(f"{path}: marked blocks changed since {e['blessed']}")
        else:
            continue
        drift += 1
    print(f"{len(store) - drift} charters clean")
    return 1 if drift else 0


cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
if cmd == "bless" and args:
    sys.exit(bless(args))
if cmd == "check" and not args:
    sys.exit(check())
sys.exit("usage: mission-guard bless <file>... | mission-guard check")
