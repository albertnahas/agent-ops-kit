#!/usr/bin/env python3
"""Model-free guard for the protected parts of a charter: the text inside its mission markers,
an HTML comment line `mission` to open a block and `/mission` to close it.

mission-guard bless <file>...  record each charter's marked blocks as they are on its repo's default branch
mission-guard check            alert when a recorded charter's blocks changed on the default branch since its bless
mission-guard pr               run in a PR checkout: exit 1 if the working tree changes a recorded charter's blocks

State lives in $AGENT_OPS_DIR/missions.json (default ~/.agent-ops). Push your own edit, then bless it.
The heartbeat runs check; a PR grader runs pr and grades a hit X, whatever the model thinks."""
import datetime as dt, difflib, json, os, re, subprocess, sys
from pathlib import Path

OPS = Path(os.environ.get("AGENT_OPS_DIR", Path.home() / ".agent-ops"))
STORE = OPS / "missions.json"
OPEN = "<!-- mission -->"
MARKER = re.compile(r"^[ \t]*(<!-- /?mission -->)[ \t]*$", re.M)
ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}


def blocks(text):
    """The marked blocks, or an error string when the markers don't pair up."""
    out, start = [], None
    for m in MARKER.finditer(text):
        if (m.group(1) == OPEN) == (start is not None):
            return f"unpaired {m.group(1)} at line {text.count(chr(10), 0, m.start()) + 1}"
        if m.group(1) == OPEN:
            start = m.end()
        else:
            out.append(text[start:m.start()].strip())
            start = None
    return "unclosed mission block" if start is not None else out


def git(repo, *args):
    try:
        return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, env=ENV, timeout=60)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out")


def default_text(repo, rel):
    """(text of the file on origin's default branch, None) or (None, why not)."""
    if git(repo, "fetch", "-q", "origin").returncode:
        return None, "fetch failed"
    branch = re.search(r"ref: refs/heads/(\S+)\s+HEAD", git(repo, "ls-remote", "--symref", "origin", "HEAD").stdout)
    if not branch:
        return None, "can't read origin's default branch"
    shown = git(repo, "show", f"origin/{branch.group(1)}:{rel}")
    return (shown.stdout, None) if shown.returncode == 0 else (None, f"missing on origin/{branch.group(1)}")


def load():
    return json.loads(STORE.read_text()) if STORE.exists() else {}


def diff(old, new):
    lines = [l for l in list(difflib.unified_diff(old.splitlines(), new.splitlines(), lineterm="", n=0))[2:] if l[:1] in "+-"]
    return "\n".join("    " + l for l in lines[:8])


def bless(files):
    store, found = load(), {}
    for f in files:
        p = Path(f).expanduser().resolve()
        top = git(str(p.parent), "rev-parse", "--show-toplevel").stdout.strip() if p.is_file() else ""
        if not top:
            return f"{f}: not a file in a git repo"
        rel = str(p.relative_to(Path(top).resolve()))
        local = blocks(p.read_text())
        if isinstance(local, str) or not local:
            return f"{f}: {local or 'no mission blocks'}"
        remote, why = default_text(top, rel)
        if why:
            return f"{f}: {why}"
        if blocks(remote) != local:
            return f"{f}: its mission blocks differ from origin's default branch. Push first, then bless."
        found[str(p)] = {"repo": top, "rel": rel, "blocks": local, "blessed": dt.date.today().isoformat()}
    store.update(found)
    OPS.mkdir(parents=True, exist_ok=True)
    STORE.write_text(json.dumps(store, indent=2) + "\n")
    print("\n".join(f"blessed {p}" for p in found))


def check():
    """Prints `drift: <path>` (with the diff) or `unreadable: <path>: <why>` per charter.
    Exits 1 on any drift, else 2 if any charter couldn't be read, else 0."""
    store, drift, unread = load(), 0, 0
    for path, e in store.items():
        text, why = default_text(e["repo"], e["rel"])
        now = why or blocks(text)
        if now == e["blocks"]:
            continue
        if why:
            unread += 1
            print(f"unreadable: {path}: {why}")
        elif isinstance(now, str):
            drift += 1
            print(f"drift: {path}: {now} since the bless on {e['blessed']}")
        else:
            drift += 1
            print(f"drift: {path}: changed since the bless on {e['blessed']}\n{diff(chr(10).join(e['blocks']), chr(10).join(now))}")
    print(f"{len(store) - drift - unread} of {len(store)} charters clean")
    return 1 if drift else 2 if unread else 0


def pr():
    top = Path(git(".", "rev-parse", "--show-toplevel").stdout.strip() or ".").resolve()
    url = git(str(top), "remote", "get-url", "origin").stdout
    hits = 0
    for e in load().values():
        if Path(e["repo"]).resolve() != top and (not url or git(e["repo"], "remote", "get-url", "origin").stdout != url):
            continue
        f = top / e["rel"]
        if (blocks(f.read_text()) if f.is_file() else "deleted") != e["blocks"]:
            hits += 1
            print(f"{e['rel']}: this checkout changes its mission blocks. Grade X.")
    print(f"{hits} charter(s) with changed mission blocks")
    return 1 if hits else 0


cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
if cmd == "bless" and args:
    sys.exit(bless(args))
if cmd in ("check", "pr") and not args:
    sys.exit(check() if cmd == "check" else pr())
sys.exit("usage: mission-guard bless <file>... | mission-guard check | mission-guard pr")
