#!/bin/bash
# ops-check [-l loop] -- <command...>
# The outcome check every scheduled loop ends with: a cheap command, no LLM, that exits 0
# only when the run did its job (the report landed, the post reads back). Prints and appends
# one ledger line: {"loop","date","check":"pass"|"fail","detail"}. A loop's success is its
# last check, not Claude's exit code, and a check also fails when the loop's last ledger line is a Claude run
# that crashed (usage limit, API error): the files it checks may be yesterday's. Loop name defaults as in claude-run.
OPS="${AGENT_OPS_DIR:-$HOME/.agent-ops}"; mkdir -p "$OPS"
LOOP="${OPS_LOOP:-$XPC_SERVICE_NAME}"; [[ "$LOOP" =~ ^(0?|application\..*)$ ]] && LOOP=adhoc
[ "$1" = "-l" ] && { LOOP="$2"; shift 2; }
[ "$1" = "--" ] && shift
[ $# -gt 0 ] || { echo "ops-check: no check command, so nothing to pass" >&2; exit 2; }
out=$("$@" 2>&1); code=$?
crash=$(grep -F "\"loop\":\"$LOOP\"" "$OPS/runs.jsonl" 2>/dev/null | tail -1 | jq -r 'select(has("check") | not) | select(.exit != 0 or .is_error == true) | "claude run at \(.date) crashed (exit \(.exit))"' 2>/dev/null)
[ -n "$crash" ] && { out="$out"$'\n'"$crash"; code=1; }
[ -s "$OPS/runs.jsonl" ] && [ -n "$(tail -c1 "$OPS/runs.jsonl")" ] && echo >> "$OPS/runs.jsonl"  # never glue onto a cut line
status=$([ $code -eq 0 ] && echo pass || echo fail)
# The loop's North Star, its Good: a check prints `good: <value> <higher|lower> [<bar>]` for a level, or `good: <total> total [<bar>]`
# for a running total (followers, revenue, users), whose value is the gain over the 7 days before, read from this ledger's
# earlier totals. The last such line adds value, better, bar and total to the ledger line, on a fail too. Plain decimals only.
read -r value better bar <<<"$(printf '%s\n' "$out" | tr -d '\r' | sed 's/[[:space:]]*$//' | grep -E '^good: -?[0-9]+(\.[0-9]+)? (higher|lower|total)( -?[0-9]+(\.[0-9]+)?)?$' | tail -1 | cut -d' ' -f2-)"
total=; if [ "$better" = total ]; then
  total=$value better=higher
  week=$(date -v-7d +%FT%T 2>/dev/null || date -d '7 days ago' +%FT%T)
  before=$(grep -F "\"loop\":\"$LOOP\"" "$OPS/runs.jsonl" | jq -r --arg w "$week" 'select(.total != null and .date <= $w) | .total' 2>/dev/null | tail -1)
  value=$([ -n "$before" ] && jq -n "$total - $before")
fi
jq -cn --arg loop "$LOOP" --arg d "$(date +%FT%T)" --arg s "$status" --arg detail "$(printf '%s' "$out" | tail -3 | iconv -c -f UTF-8 -t UTF-8 | cut -c1-300)" \
  --arg value "$value" --arg better "$better" --arg bar "$bar" --arg total "$total" \
  '{loop:$loop,date:$d,check:$s,detail:$detail} + if $value == "" then {} else {value:($value|tonumber),better:$better}
   + if $bar == "" then {} else {bar:($bar|tonumber)} end end + if $total == "" then {} else {total:($total|tonumber)} end' | tee -a "$OPS/runs.jsonl"
exit $code
